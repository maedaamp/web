---
import { nav, site } from '../data/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container inner">
    <a href="/" class="logo">{site.name}</a>
    <nav aria-label="メインナビゲーション">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class:list={{ 'contact-link': item.href === '/contact/' }} aria-current={currentPath === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 22px;
    padding-bottom: 22px;
  }

  .logo {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.125rem;
  }

  ul {
    display: flex;
    align-items: center;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-accent);
  }

  nav a.contact-link {
    display: inline-block;
    padding: 8px 18px;
    border: 1px solid var(--color-border);
    color: var(--color-accent);
  }

  @media (max-width: 720px) {
    .inner {
      gap: 14px;
      padding-top: 16px;
      padding-bottom: 16px;
    }

    .logo { font-size: 1rem; }
    ul { gap: 18px; }
    nav a { font-size: .8rem; }
    nav a.contact-link { padding: 6px 12px; }
  }
</style>
